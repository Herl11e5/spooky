# Spooky, the brain of the PiCrawler: hears, talks, recognises people, decides.
# It never touches the hardware — picrawler.service (the body) does — so the two run
# together. It moves the robot only while a person allows it on the dashboard.
#
#   sudo cp deploy/spooky-brain.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now spooky-brain
#
# Never run the old spooky.service (direct SunFounder hardware access) alongside.

[Unit]
Description=Spooky brain (picrawler body client)
After=network-online.target picrawler.service sound.target
Wants=network-online.target

[Service]
User=spooky
Group=spooky
SupplementaryGroups=audio gpio
WorkingDirectory=/home/spooky/spooky-brain
Environment=PYTHONUNBUFFERED=1
# Ollama on the Mac (gemma3:12b): text and vision
Environment=OLLAMA_HOST=http://MacBook-Pro-di-Samuele.local:11434
ExecStart=/home/spooky/spooky-brain/.venv/bin/python main.py --local-config config/picrawler-pi.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
